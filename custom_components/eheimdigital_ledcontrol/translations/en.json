      },
      "hyst_high": {
        "name": "Upper hysteresis threshold"
      },
      "hyst_low": {
        "name": "Lower hysteresis threshold"
      },
      "low_pulse_time": {
        "name": "Low pulse duration"
      },
      "manual_speed": {
        "name": "Manual speed"
